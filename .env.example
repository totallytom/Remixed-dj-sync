# Supabase project URL (Project Settings → API).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Token verification: set the legacy JWT secret (Project Settings → API → JWT Settings),
# or leave it empty to verify with the project's signing keys (JWKS).
SUPABASE_JWT_SECRET=

# Service-role key — used only to check group-chat membership. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
